OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
APP_SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example.com/auth/google/callback
ALLOWED_EMAILS=you@example.com,friend@example.com
ADMIN_EMAILS=

# Production storage
DATABASE_URL=postgres://user:password@host:5432/form_builder
GCS_TEMPLATE_BUCKET=your-template-bucket

# Optional Corfix publish on template save
# CORFIX_API_TOKEN=replace-me
# CORFIX_COMPANY_ID=6926684acbe679718276867d
# CORFIX_API_BASE_URL=https://api.dev.corfix.com

# Optional feature flags
# Set any of these to 0 to disable the corresponding UI and route in a public deployment.
# ENABLE_FILE_UPLOADS=1
# ENABLE_AI_DICTATION=1
# ENABLE_IMAGE_EXTRACTION=1

# Optional local dev overrides
DEV_AUTH_USER_ID=default
DEV_WORKSPACE_ID=default
DEV_AUTH_EMAIL=dev@example.com
DEV_AUTH_NAME=Default Workspace
TEMPLATE_LIBRARY_ROOT=/var/lib/form-builder/template-library
PORT=3000
