NODE_ENV=staging
PORT=3000
TRUST_PROXY=1
TEMPLATE_LIBRARY_ROOT=/var/lib/form-builder/template-library

# Google OAuth
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=https://forms.example.com/auth/google/callback

# Access control
ALLOWED_EMAILS=you@example.com,friend@example.com
ADMIN_EMAILS=you@example.com

# Session security
APP_SESSION_SECRET=replace-with-a-long-random-secret

# Cost controls for a short private beta
ENABLE_AI_ASSIST=0
ENABLE_AI_TRANSLATION=0
ENABLE_FILE_UPLOADS=0
ENABLE_AI_DICTATION=0
ENABLE_IMAGE_EXTRACTION=0

# Optional if you decide to keep AI enabled
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-4.1-mini
